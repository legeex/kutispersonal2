      "destination": "/cz/registrace.html",
      "permanent": true
    },
    {
      "source": "/fuer-unternehmen(/|\\.html)?",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/de/berufe/:path*",
      "destination": "/subunternehmer/",
      "permanent": true
    },
    {
      "source": "/de/:path*",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/cs/:path*",
      "destination": "/cz/",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        }
      ]
    },
    {
      "source": "/assets/(fonts|img)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
